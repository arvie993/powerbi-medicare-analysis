      "color": "#424242"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{"color": {"solid": {"color": "#FFFFFF"}}}],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {"solid": {"color": "#212121"}}
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [{"color": {"solid": {"color": "#F8F9FA"}}}]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "fontFamily": "Segoe UI Light",
            "color": {"solid": {"color": "#0077B6"}}
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "color": {"solid": {"color": "#616161"}}
          }
        ]
      }
    }
  }
